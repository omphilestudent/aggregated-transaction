# Copy to .env. Never commit .env or production secrets.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-local-db-password
DB_PASSWORD=replace-with-local-db-password
# Shared HMAC secret between gateway and aggregation service (min 32 bytes).
AGGREGATION_JWT_SECRET=replace-with-32-plus-random-bytes
AGGREGATION_JWT_ISSUER=transaction-aggregation-demo
# Build-time Java trust store, required by `docker compose build` (create it with
# scripts/dev/generate-truststore.sh; see README). Never copied into an image.
TRUSTSTORE_FILE=./.local/truststore.jks
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=9092
API_GATEWAY_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
CUSTOMER_SERVICE_HOST_PORT=8081
ACCOUNT_SERVICE_HOST_PORT=8082
TRANSACTION_SERVICE_HOST_PORT=8083
AGGREGATION_SERVICE_HOST_PORT=8088
